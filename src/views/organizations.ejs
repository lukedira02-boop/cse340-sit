<%- include('partials/header') %>

<main id="main-content" class="container">
    <h1><%= title %></h1>
    <p class="lead">These community groups host the projects you can join.</p>

    <div class="card-grid">
        <article class="card">
            <img src="/images/green-valley-alliance.svg" alt="Green Valley Alliance logo: a leaf above rolling hills" width="320" height="200">
            <div class="card-body">
                <h2>Green Valley Alliance</h2>
                <p>Restores local parks, plants trees, and organizes river cleanups.</p>
                <p class="contact"><a href="mailto:hello@greenvalley.example">hello@greenvalley.example</a></p>
            </div>
        </article>

        <article class="card">
            <img src="/images/bright-futures-tutoring.svg" alt="Bright Futures Tutoring logo: an open book with a star" width="320" height="200">
            <div class="card-body">
                <h2>Bright Futures Tutoring</h2>
                <p>Offers free after-school tutoring and reading help for local students.</p>
                <p class="contact"><a href="mailto:learn@brightfutures.example">learn@brightfutures.example</a></p>
            </div>
        </article>

        <article class="card">
            <img src="/images/helping-hands-health.svg" alt="Helping Hands Health logo: a heart held in two hands" width="320" height="200">
            <div class="card-body">
                <h2>Helping Hands Health</h2>
                <p>Runs wellness fairs, food drives, and neighborhood health check-ins.</p>
                <p class="contact"><a href="mailto:care@helpinghands.example">care@helpinghands.example</a></p>
            </div>
        </article>
    </div>
</main>

<%- include('partials/footer') %>
