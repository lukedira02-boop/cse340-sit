<%- include('partials/header') %>

<main id="main-content" class="container">
    <h1><%= title %></h1>
    <p class="lead">These community groups host the projects you can join.</p>

    <div class="card-grid">
        <% organizations.forEach((organization) => { %>
            <article class="card">
                <% if (organization.logo) { %>
                    <img src="<%= organization.logo %>" alt="<%= organization.name %> logo" width="320" height="200">
                <% } %>
                <div class="card-body">
                    <h2><%= organization.name %></h2>
                    <p><%= organization.description %></p>
                    <p class="contact"><a href="mailto:<%= organization.email %>"><%= organization.email %></a></p>
                </div>
            </article>
        <% }) %>
    </div>
</main>

<%- include('partials/footer') %>
