<%- include("partials/header", { title }) %>
  <main id="main-content">
    <section class="page-heading">
      <p class="eyebrow">Upcoming opportunities</p>
      <h1>Service Projects</h1>
      <p>Choose a project and make a direct impact in your community.</p>
    </section>
    <section class="section">
      <div class="card-grid three">
        <% projects.forEach((project) => { %>
          <article class="project-card">
            <% if (project.imagePath) { %>
              <img class="project-card-image" src="<%= project.imagePath %>" alt="">
            <% } %>
            <p class="card-tag">
              <% if (project.schedule) { %>
                <%= new Date(project.schedule).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }) %>
              <% } else { %>
                Schedule to be announced
              <% } %>
            </p>
            <h2><%= project.name %></h2>
            <p><%= project.description %></p>
            <p>Location: <%= project.location || "Location to be announced" %></p>
            <p>Organization: <%= project.organizationName %></p>
            <a href="/categories">View categories</a>
          </article>
        <% }) %>
      </div>
    </section>
  </main>
<%- include("partials/footer") %>
