<%- include("partials/header", { title }) %>
  <main id="main-content">
    <section class="page-heading">
      <p class="eyebrow">Our community partners</p>
      <h1>Organizations</h1>
      <p>Meet local groups creating positive change through service.</p>
    </section>
    <section class="section">
      <div class="card-grid organization-grid">
        <article class="organization-card">
          <img src="/images/food-bank.jpg" alt="Community Food Pantry">
          <div><p class="card-tag">Community Service</p><h2>Community Food Pantry</h2><p>Fights food insecurity by collecting, sorting, and distributing groceries to local families.</p></div>
        </article>
        <article class="organization-card">
          <img src="/images/green-city.jpg" alt="Green City Alliance">
          <div><p class="card-tag">Environmental</p><h2>Green City Alliance</h2><p>Improves neighborhoods through cleanups, conservation projects, and community education.</p></div>
        </article>
        <article class="organization-card">
          <img src="/images/youth-center.webp" alt="Bright Futures Youth Center">
          <div><p class="card-tag">Educational</p><h2>Bright Futures Youth Center</h2><p>Supports students with tutoring, mentoring, and after-school enrichment activities.</p></div>
        </article>
      </div>
    </section>
  </main>
<%- include("partials/footer") %>
